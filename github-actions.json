{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "GitHub Actions rules. Pins all actions to SHA digests (supply-chain hardening), groups updates.",
  "packageRules": [
    {
      "description": "Pin GitHub Actions to digests and group non-major updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "pinDigests": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Separate major GitHub Actions updates for review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false,
      "labels": ["dependencies", "github-actions", "breaking-change"]
    }
  ]
}
